    {
      "id": 3,
      "title": "JVM GC Pauses",
      "type": "timeseries",
      "description": "Estimated number of GC pauses during the preceding two minutes",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(jvm_gc_pause_seconds_count{job=\"grafana-demo\"}[2m]))",
